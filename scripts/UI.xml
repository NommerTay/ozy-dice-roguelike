<!-- =====================================================================
     Cozy Dice Roguelike - Global UI  (paste into: Modding > Scripting >
     Global > UI tab in Tabletop Simulator)

     One fancy button, bottom-centre of the screen, for every player.

     BEFORE IT WORKS - one-time setup in TTS:
       1. Games > ... actually: Modding > Custom UI Assets > Add
       2. Name it exactly:  CozyRollButton
          URL:  https://raw.githubusercontent.com/NommerTay/ozy-dice-roguelike/main/assets/icons/roll_button.png
       (TTS Global UI images must be registered as Custom UI Assets -
        a bare URL in the <Image> tag will not load.)

     The button calls onRollClicked() in Global.lua.
     ===================================================================== -->
<Panel
    id="CozyDiceUI"
    rectAlignment="BottomCenter"
    rectOffset="0 28 0 0"
    width="240"
    height="92"
    color="#00000000"
    outline="#00000000">

    <Button
        id="rollButton"
        onClick="onRollClicked"
        colors="#FFF3D6|#FFE3A3|#E8C48A|#B8A88F"
        outline="#3E2723"
        outlineSize="3 3"
        cornerRadius="18"
        fontSize="30"
        textColor="#3E2723">
        <HorizontalLayout spacing="10" padding="14 14 8 8" childForceExpandWidth="false" childForceExpandHeight="false">
            <Image image="CozyRollButton" width="56" height="56" preserveAspect="true" />
            <Text fontSize="30" fontStyle="Bold" color="#3E2723" alignment="MiddleLeft">Roll</Text>
        </HorizontalLayout>
    </Button>

</Panel>
